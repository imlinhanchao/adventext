<%- include('header') %>
<article class="h-full w-full max-w-[700px]">
  <form action="" method="post">
    <header class="pb-10">
        <h1 class="text-center">@<%= account.nickname || account.username %></h1>
    </header>
<% if (locals.user?.username == account.username) { %>
    <section>
<% if (locals.error) { %>
      <p class="<%= type -%> message"><%= message -%></p>
<% } %>
      <form action="" method="post">
        <fieldset class="profile">
          <legend>个人资料</legend>
          <p>
            <label for="username">昵称</label>
            <input type="text" name="nickname" id="username" class="text" value="<%=user.nickname||''%>" placeholder="用户名" maxlength="20"/>
          </p>
          <p>
            <label for="passwd">新密码</label>
            <input type="password" name="password" id="passwd" class="text" value="<%=account.passwd||''%>" placeholder="不修改无需填写" />
            <label for="oldpasswd" >旧密码</label>
            <input type="password" name="oldpassword" id="oldpasswd" class="text" value="<%=account.oldpasswd||''%>" placeholder="不修改无需填写" />
          </p>
          <p class="text-right">
            <input type="submit" value="修改" class="submit-btn" /> 
            <button class="submit-btn !bg-red-600" id="logout">退出</button>
          </p>
        </fieldset>
      </form>
    </section>
    <header class="flex space-x-2 items-center justify-center mt-10 relative">
      <h3>
        <a>我的成就</a>
      </h3>
      <span>/</span>
      <h3>
        <a href="/u/<%=account.username%>/story">我的故事</a>
      </h3>
      <span>/</span>
      <h3>
        <a href="/u/<%=account.username%>/draft">我的草稿</a>
      </h3>
      <span class="absolute right-2">
        <a href="https://docs.adventext.fun/" title="创作帮助" target="_blank" class="!border-none">❓</a>
        <a href="/admin/" title="创作故事" target="_blank" class="!border-none">✚</a>
      </span>
    </header>
<% } else { %>
    <section>
      <p>
        <span class="user-info" title="昵称"><%=account.nickname%></span>
        <span class="user-info"><b>上次登录：</b> <script>document.write(new Date(<%=Number(user.lastLogin)-%>).toLocaleString())</script></span>
      </p>
    </section>
    <header class="flex space-x-2 items-center justify-center mt-10 relative">
      <h3 class="text-center">TA的成就</h3>
      <span>/</span>
      <h3 class="text-center"><a href="/u/<%=account.username%>/story">TA的故事</a></h3>
    </header>
<% } %>
    <section class="my-3 pl-5 w-full">
      <ol class="list-decimal space-y-2 w-full">
        <% stories.forEach(function(story) { %>
          <li class="w-full">
            <section class="flex flex-col w-full">
              <span class="flex justify-between items-bottom w-full">
                <span>
                  <a href="/s/<%=story.id-%>">
                    <%= story.name %>
                  </a>
                </span>
                <span>
                  <a href="/u/<%= story.author %>" class="text-gray-500 dark:text-light-900 text-sm truncate"
                    title="作者">
                    <%= story.author %>
                  </a>
                </span>
              </span>
              <span class="text-gray-500 dark:text-light-900 text-sm truncate" title="<%= story.description %>">
                <%= story.description %>
              </span>
            </section>
            <section class="space-x-2">
            <% story.achievements.forEach(function(ach) { %>
              <span class="text-xs text-gray-500 dark:text-light-900 border bg-current border-current rounded p-1" title="成就：<%= ach.description || ach.name %>">
                <span class="text-white">🏆 <%= ach.name %></span>
              </span>
            <% }); %>
            <% story.ends.forEach(function(end) { %>
              <span class="text-xs text-gray-500 dark:text-light-900 border bg-current border-current rounded p-1" title="结局：<%= end.end %>">
                <span class="text-white">📍 <%= end.end %></span>
              </span>
            <% }); %>
            </section>
          </li>
        <% }); %>
      </ol>
    <% if (stories.length === 0) { %>
      <p>还没有游玩的故事.</p>
    <% } %>
    </section>
    <script>
      const logout = document.getElementById("logout");
      if (logout){
        logout.onclick = function(ev) {
            if(confirm("你确定要退出登录吗？")) location = '/auth/logout';
            return false;
        }
      }
    </script>
</article>
<%- include('footer') %>
