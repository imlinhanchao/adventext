<%- include('header') %>

  <article class="max-w-[400px] w-full mx-auto">
    <section class="w-full pl-5">
      <ol class="list-decimal w-full">
        <% stories.forEach(function(story) { %>
          <li class="w-full">
            <section class="flex flex-col w-full">
              <span class="flex justify-between items-bottom w-full">
                <span>
                  <a href="<%=query.type === 'draft' ? '/d' : '/s'-%>/<%=story.id-%>">
                    <%= story.name %>
                  </a>
                  <span class="p-1 inline-block text-gray-500 dark:text-light-900 text-xs">
                    <% if (locals.isLogin) { %>
                    <span class="space-x-1">
                      <span title="结局" class="border-current border-dashed border p-1 rounded">📍<%= story.finish %>/<%= story.end %></span> 
                      <% if (story.target) { %><span title="成就" class="border-current border p-1 rounded">🏆<%= story.achievement %>/<%= story.target %></span><% } %>
                    </span>
                    <% } else { %>
                    <span class="space-x-1">
                      <span title="结局" class="border-current border-dashed p-1 border rounded">📍<%= story.end %> </span> 
                      <% if (story.target) { %><span title="成就" class="border-current p-1 border rounded">🏆<%= story.target %></span> <% } %>
                    </span>
                    <% } %>
                  </span>
                </span>
                <span>
                  <a href="/u/<%= story.author %>" class="text-gray-500 dark:text-light-900 text-sm truncate"
                    title="作者">
                    <%= story.author %>
                  </a>
                </span>
              </span>
              <span class="text-gray-500 dark:text-light-900 text-sm truncate" title="<%= story.description %>">
                <%= story.description %>
              </span>
            </section>
          </li>
          <% }); %>
      </ol>
      <% if (stories.length===0) { %>
        <p>还没有故事.</p>
        <% } %>
    </section>
  </article>
  <%- include('footer') %>